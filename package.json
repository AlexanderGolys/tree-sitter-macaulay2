{
  "name": "tree-sitter-macaulay2",
  "version": "6.3.4",
  "description": "Macaulay2 grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parser",
    "lexer",
    "macaulay2",
    "tree-sitter"
  ],
  "author": "Alexander Golys <alexandergolys@gmail.com> (https://spectralflux.dev)",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://spectralflux.dev/projects/tree-sitter-macaulay2",
  "bugs": {
    "url": "https://github.com/AlexanderGolys/tree-sitter-macaulay2/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderGolys/tree-sitter-macaulay2.git"
  },
  "files": [
    "bindings/node",
    "binding.gyp",
    "prebuilds/**",
    "queries",
    "src",
    "grammar.js",
    "tree-sitter.json",
    "*.wasm",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "build:wasm": "tree-sitter build --wasm",
    "build:node": "prebuildify -t 20.19.5",
    "test": "tree-sitter test --rebuild",
    "test:node": "node --test bindings/node/*_test.js",
    "check": "tree-sitter test --rebuild",
    "parse": "tree-sitter parse",
    "parse:examples": "tree-sitter parse --quiet examples/*.m2 test/test_generator/test_expressions/*.m2"
  },
  "tree-sitter": [
    {
      "scope": "source.macaulay2",
      "file-types": [
        "m2",
        "M2",
        "macaulay2"
      ],
      "injection-regex": "^m2$|^macaulay2$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "indent": "queries/indents.scm",
      "tags": "queries/tags.scm",
      "folds": "queries/folds.scm"
    }
  ],
  "install_info": {
    "files": [
      "src/parser.c",
      "src/scanner.c"
    ]
  },
  "engines": {
    "node": ">=18 <26"
  }
}
