{
  "grammars": [
    {
      "name": "macaulay2",
      "camelcase": "Macaulay2",
      "scope": "source",  
      "path": ".",
      "file-types": ["m2", "M2"],
      "highlights": "queries/macaulay2/highlights.scm",
      "tags": "queries/macaulay2/tags.scm",
	    "indent": "queries/macaulay2/indents.scm",
	    "folds": "queries/macaulay2/folds.scm",
      "description": "Tree-sitter grammar for the Macaulay2 language",
      "repository": "https://github.com/AlexanderGolys/tree-sitter-macaulay2",
      "version": "1.2.0"
    }
  ],

  "metadata": {
    "version": "1.2.0",
    "license": "MIT",
    "description": "Macaulay2 grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/AlexanderGolys/tree-sitter-macaulay2"
    },
    "authors": [
        {
          "name": "Alexander Golys",
          "email": "alexandergolys@gmail.com"
        }]
  },
  
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
