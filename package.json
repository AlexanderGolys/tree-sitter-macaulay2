{
  "name": "tree-sitter-macaulay2",
  "version": "1.3.0",
  "description": "Macaulay2 grammar for tree-sitter",
  "main": "bindings/node",
  "keywords": [
    "parser",
    "lexer",
    "macaulay2",
    "tree-sitter"
  ],
  "author": "Alexander Golys <alexandergolys@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderGolys/tree-sitter-macaulay2.git"
  },
  "files": [
    "bindings",
    "binding.gyp",
    "queries",
    "src",
    "grammar.js",
    "tree-sitter.json",
    "README.md",
    "LICENCE"
  ],
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.3"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:generated": "bash test/test_generator/generate_tests.sh && tree-sitter test",
    "check": "tree-sitter generate && tree-sitter test",
    "check:generated": "bash test/test_generator/generate_tests.sh && tree-sitter test && git diff --exit-code -- test/corpus",
    "parse": "tree-sitter parse",
    "parse:examples": "tree-sitter parse --quiet examples/*.m2"
  },
  "tree-sitter": [
    {
      "scope": "source.macaulay2",
      "file-types": [
        "m2",
        "M2",
        "macaulay2"
      ],
      "injection-regex": "^m2$|^macaulay2$",
      "highlights": "queries/macaulay2/highlights.scm",
      "indent": "queries/macaulay2/indents.scm",
      "tags": "queries/macaulay2/tags.scm",
      "folds": "queries/macaulay2/folds.scm"
    }
  ],
  "install_info": {
    "files": [
      "src/parser.c",
      "src/scanner.c"
    ]
  }
}
