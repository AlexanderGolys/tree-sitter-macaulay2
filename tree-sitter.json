{
  "grammars": [
    {
      "name": "macaulay2",
      "camelcase": "Macaulay2",
      "scope": "source.macaulay2",
      "path": ".",
      "file-types": ["m2", "M2", "macaulay2"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "tags": "queries/tags.scm",
      "indent": "queries/indents.scm",
      "folds": "queries/folds.scm",
      "description": "Tree-sitter grammar for the Macaulay2 language",
      "repository": "https://github.com/AlexanderGolys/tree-sitter-macaulay2",
      "version": "6.1.1"
    }
  ],

  "metadata": {
    "version": "6.1.1",
    "license": "MIT",
    "description": "Macaulay2 grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/AlexanderGolys/tree-sitter-macaulay2"
    },
    "authors": [
      {
        "name": "Alexander Golys",
        "email": "alexandergolys@gmail.com"
      }
    ]
  },

  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
