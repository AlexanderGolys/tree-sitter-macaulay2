{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "./src/**": "allow",
      "./grammar.js": "allow",
      "./package.json": "allow",
      "*": "ask"
    },
    "edit": {
      "./src/**": "allow",
      "./grammar.js": "allow",
      "*": "ask"
    },
    "bash": {
      "npm run build": "allow",
      "npm test": "allow",
      "*": "ask"
    }
  },
  "lsp": {
    "clangd": {
      "command": [
        "clangd",
        "--background-index"
      ]
    },
    "vtsls": {
      "command": [
        "vtsls",
        "--stdio"
      ]
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "enabled": true
    }
  }
}